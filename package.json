{
  "name": "browser-agent",
  "version": "1.0.0",
  "description": "Browser-native AI agent with an HTTP tool. Single self-contained HTML file, no backend.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
