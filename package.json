    "serve:dist": "node scripts/serve-dist.js"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
